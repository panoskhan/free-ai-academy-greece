{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Free AI Academy Website Project",
  "type": "object",
  "required": ["project", "pages", "versions", "release"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "language", "status", "updatedAt"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "language": {"type": "string"},
        "status": {"enum": ["draft", "testing", "preview", "production"]},
        "updatedAt": {"type": "string"}
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "sections"],
        "properties": {
          "id": {"type": "string"},
          "slug": {"type": "string"},
          "title": {"type": "string"},
          "sections": {"type": "array"}
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "createdAt", "status"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "createdAt": {"type": "string"},
          "status": {"enum": ["draft", "testing", "preview", "production"]},
          "hash": {"type": "string"}
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "qa", "preview", "deployment"],
      "properties": {
        "version": {"type": "string"},
        "qa": {"enum": ["pending", "passed", "failed"]},
        "preview": {"enum": ["not-ready", "ready", "reviewed"]},
        "deployment": {"enum": ["not-configured", "pending", "deployed", "failed"]}
      }
    }
  }
}
